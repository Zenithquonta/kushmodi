# Once a day, after the 21:00 night frame time in Mumbai. Persistent: a run missed while the server was down
# happens at the next boot, and --recent fills the gap.
[Unit]
Description=Render and sync the observatory archive daily

[Timer]
OnCalendar=*-*-* 21:10:00 Asia/Kolkata
Persistent=true

[Install]
WantedBy=timers.target
