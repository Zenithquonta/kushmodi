# Fetches the orbital elements (TLEs) of the ISS, Hubble and Tiangong from CelesTrak (no key) into
# /var/lib/observatory/satellites. Like the weather fetcher it may open IP sockets and writes only its own directory;
# it keeps only element lines that pass the checks in scripts/satellites.py (catalogue number, checksum, epoch window).
# The renderers stay offline and compute the passes from the stored file.
[Unit]
Description=Fetch the ISS, Hubble and Tiangong orbital elements for the live observatory

[Service]
Type=oneshot
User=observatory
Group=observatory
WorkingDirectory=/opt/observatory/repo
ExecStart=/opt/observatory/venv/bin/python /opt/observatory/repo/scripts/satellites.py fetch --out /var/lib/observatory/satellites
TimeoutStartSec=120
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/observatory/satellites
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
